.DS_Store

# Временные файлы Word при открытом документе
~$*.docx

# Архивы организаторов: распакованное содержимое лежит рядом и версионируется,
# сам .zip дублирует его двоичным блобом на десятки мегабайт
models/*.zip

# Кеш и служебное внутри распакованного расчётчика
models/CHDD_PYTHON/__MACOSX/
**/__pycache__/
